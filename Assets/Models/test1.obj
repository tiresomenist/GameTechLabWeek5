# Multi-Material Cube OBJ (Clockwise Winding for DirectX)
mtllib test1.mtl

# Vertices
v -1.0 -1.0 -1.0
v  1.0 -1.0 -1.0
v  1.0  1.0 -1.0
v -1.0  1.0 -1.0
v -1.0 -1.0  1.0
v  1.0 -1.0  1.0
v  1.0  1.0  1.0
v -1.0  1.0  1.0

# UVs
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Normals
vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn  0.0 -1.0  0.0
vn  1.0  0.0  0.0
vn  0.0  1.0  0.0
vn -1.0  0.0  0.0

# ---------------------------------------------
# Material 1: Sun Texture (-Z, +Z Faces)
# ---------------------------------------------
usemtl Mat_Sun
# Face 1: -Z
f 1/1/1 4/4/1 3/3/1
f 1/1/1 3/3/1 2/2/1
# Face 2: +Z
f 5/1/2 6/2/2 7/3/2
f 5/1/2 7/3/2 8/4/2

# ---------------------------------------------
# Material 2: Earth Texture (-Y, +X Faces)
# ---------------------------------------------
usemtl Mat_Earth
# Face 3: -Y
f 1/1/3 2/2/3 6/3/3
f 1/1/3 6/3/3 5/4/3
# Face 4: +X
f 2/1/4 3/2/4 7/3/4
f 2/1/4 7/3/4 6/4/4

# ---------------------------------------------
# Material 3: Moon Texture (+Y, -X Faces)
# ---------------------------------------------
usemtl Mat_Moon
# Face 5: +Y
f 3/1/5 4/2/5 8/3/5
f 3/1/5 8/3/5 7/4/5
# Face 6: -X
f 4/1/6 1/2/6 5/3/6
f 4/1/6 5/3/6 8/4/6
